.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store

__pycache__/
*.pyc
.venv/

# Deploy drop-in slot: keep the folder, ignore whatever project gets
# dropped into it.
deploy/app/*
!deploy/app/README.md

# VS Code Project File
Jetstream2_Dashboard_Deploy.code-workspace

# Real-world projects cloned into examples/ for testing. Unlike the
# *-hello-world fixtures, these are separate upstream repos (with their own
# .git/ and license) and shouldn't be nested into this one.
examples/WORKSHOP-interactive-shiny-dashboards/

# build_and_run.sh writes a renv.lock into whatever project it deploys.
# The bundled R example deliberately ships WITHOUT one so that smoke-testing
# it exercises the auto-generation path — so running the documented test
# shouldn't leave the tree dirty.
examples/*/renv.lock

# Host-specific bootstrap configuration. Untracked so `git pull` on an
# instance never conflicts with local settings; deploy.env.example is the
# tracked template.
deploy/deploy.env
