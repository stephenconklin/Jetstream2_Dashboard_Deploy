# Host configuration for deploy/bootstrap.sh.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   ${EDITOR:-nano} deploy/deploy.env
#   sudo ./deploy/bootstrap.sh
#
# deploy.env is gitignored — it holds host-specific detail, and keeping it
# untracked is what lets `git pull` on the instance never conflict.
#
# Every value here has a working default. A bootstrap run with no deploy.env
# at all uses those defaults, which is the right answer for a plain
# Jetstream2 instance serving on its floating IP over HTTP.

# ---------------------------------------------------------------------------
# Hostname and TLS
# ---------------------------------------------------------------------------
# A public DNS name pointed at this instance's floating IP. Leave EMPTY to
# serve plain HTTP on the bare IP, which is the usual Jetstream2 case and
# changes nothing about how the dashboard is served.
#
# Usually you don't edit this by hand: the desktop app's Manage tab (Web
# address → Check → Use this name with HTTPS) or
#   sudo ./deploy/bootstrap.sh --set-domain dashboard.example.org
# checks the name points here, gets the certificate, and only then writes it
# here — so a name that isn't ready leaves everything as it was. Set by hand,
# it's used the next time bootstrap.sh runs; a name that doesn't point here
# yet just keeps plain HTTP until it does.
#
# Let's Encrypt CANNOT issue a certificate for a bare IP address.
SERVER_NAME=""

# Optional contact address for the Let's Encrypt account. Renewal is
# automatic and Let's Encrypt no longer sends expiry reminders, so leaving it
# empty is fine.
CERTBOT_EMAIL=""

# Where certificates come from. Empty means Let's Encrypt's production
# service. To rehearse without touching production's rate limits, use
# Let's Encrypt staging: https://acme-staging-v02.api.letsencrypt.org/directory
# (its certificates aren't trusted by browsers).
CERTBOT_SERVER=""

# Obtain and serve a certificate for SERVER_NAME. Ignored when SERVER_NAME is
# empty or is an IP address.
ENABLE_TLS="yes"

# ---------------------------------------------------------------------------
# Where the app sits behind nginx
# ---------------------------------------------------------------------------
# The loopback port the dashboard container publishes on. nginx proxies port
# 80 to it. Only worth changing if something else on the host already uses
# this port — the app is not reachable on it from outside regardless, because
# it binds 127.0.0.1 only.
APP_HOST_PORT="8080"

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# Host directory holding your dashboard's data, bind-mounted into the
# container at deploy time. Only consulted when bootstrap.sh is given a
# project to deploy — otherwise build_and_run.sh handles this itself and
# prompts if a project needs it.
#
# Set it here to make `sudo ./deploy/bootstrap.sh /path/to/project` work
# unattended for a project that ships a data/ directory. Typically a mounted
# Jetstream2 volume under /media/volume/<volume-name>/...
#
# bootstrap.sh does NOT create or populate this. Research datasets are
# routinely tens of GB and must be copied onto an attached volume separately.
DATA_DIR=""

# ---------------------------------------------------------------------------
# nginx tuning
# ---------------------------------------------------------------------------
# Largest request body nginx will accept. This is what limits file uploads
# through Shiny's fileInput or Streamlit's st.file_uploader. nginx's own
# default is 1m, which rejects an ordinary CSV with a 413 the app never sees.
CLIENT_MAX_BODY_SIZE="100m"

# Per-IP request rate and burst. One page load of a Shiny or Streamlit app is
# a burst of dozens of asset requests, and a map that serves its own tiles
# (PMTiles read in byte ranges) asks for 35 or more per view on a large
# screen, so the burst is deliberately generous. It also has to cover several
# people at once: a workshop or classroom on one network arrives from one
# address and shares one allowance. At the old 10r/s / 60, a burst of 80 tile
# requests from one browser had 12 refused (blank map squares); at these
# values 250 all succeed. The rate is still far below a scanner sweep.
RATE_LIMIT="30r/s"
RATE_BURST="200"

# Per-IP concurrent connection cap. Each open browser tab of a Shiny or
# Streamlit dashboard holds one long-lived WebSocket, so this cannot be set
# as tightly as it could for a request/response app. Raise it if your
# audience sits behind a shared institutional NAT and reports being blocked.
CONN_LIMIT="32"

# Idle timeout on a proxied connection. Must stay well above a few minutes:
# Shiny and Streamlit WebSockets sit idle whenever nobody is clicking, and a
# short value tears them down mid-session — which the frameworks show as
# "Disconnected from server" with nothing in their own logs to explain it.
PROXY_TIMEOUT="3600s"

# ---------------------------------------------------------------------------
# Host provisioning toggles
# ---------------------------------------------------------------------------
# Swapfile size, as an OOM safety net. "0" skips it. Without swap, a large R
# geospatial build on a small instance can have the kernel pick an OOM victim
# — and the victim it picks may be sshd rather than the build.
SWAP_SIZE="2G"

# The sidecar that restarts a container Docker has marked unhealthy. Docker
# does not act on health status by itself: `--restart unless-stopped` only
# reacts to the process exiting, so an app that is alive but wedged stays
# broken indefinitely without this.
ENABLE_AUTOHEAL="yes"

# Enable the ufw firewall, allowing only SSH and nginx.
#
# Defaults to "no" because a firewall mistake on a remote instance locks YOU
# out. Don't take that to mean the security group covers everything: an
# Exosphere desktop instance was found with its VNC port open to the
# internet, which PROTECT_VNC below closes whether or not ufw is on. Turn ufw
# on only if you have a reason to, and confirm SSH from a second terminal
# before closing the one that ran bootstrap. It's also worth checking the
# instance's security group in Exosphere/Horizon allows only what you expect.
ENABLE_UFW="no"

# Close the desktop's VNC ports (5900-5910) to everything except this host
# and Docker, where Guacamole runs, and keep them closed across reboots.
# Exosphere's desktop instances run TurboVNC on every address for Guacamole;
# left open, internet bots filled all of its connection slots, so the web
# desktop stopped connecting, and every one of them was trying the VNC
# password. Guacamole and an SSH tunnel both still work. Harmless on an
# instance with no VNC. Set to "no" only if you connect a VNC client directly
# from outside, which exposes the desktop to the same bots.
PROTECT_VNC="yes"
